-- Stackage snapshot matching nixos-unstable haskellPackages.
-- Pins the package set and the compiler (ghc-9.10.3).
import: https://www.stackage.org/lts-24.33/cabal.config

packages: */*.cabal

allow-newer: lzma-conduit:*

-- Pin packages that are not in the Stackage snapshot.
constraints:
  lzma-conduit ==1.2.3,
  microlens-pro ==0.2.0.4,
  hnix-store-core ==0.8.0.0,
  hnix-store-nar ==0.1.1.0,
  nix-derivation ==1.1.3,
  hercules-ci-cnix-store ==0.4.1.0,
  cabal-pkg-config-version-hook ==0.1.1.0

-- The hackage release for amazonka is outdated.
-- Use the same rev from source as nixpkgs-unstable.
source-repository-package
  type: git
  location: https://github.com/brendanhay/amazonka
  -- 2.0-unstable-2025-04-16
  tag: 7645bd335f008912b9e5257486f622b674de7afa
  subdir:
    lib/amazonka
    lib/amazonka-core
    lib/services/amazonka-s3
    lib/services/amazonka-sso
    lib/services/amazonka-sts
